PORT=3001
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/stockflow?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d
NODE_ENV=development

# CORS — set to your frontend URL in production (e.g. https://myapp.vercel.app)
# Leave unset in development to allow all origins
ALLOWED_ORIGIN=
